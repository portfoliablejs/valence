{
  "name": "@portfoliablejs/valence",
  "version": "0.2.0",
  "description": "Valence web component design system used by Portfoliable",
  "private": false,
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/portfoliablejs/valence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portfoliablejs/valence.git"
  },
  "bugs": {
    "url": "https://github.com/portfoliablejs/valence/issues"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "src/main.js",
  "exports": {
    ".": "./src/main.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "generate:thumbnail-manifest": "node scripts/generate-thumbnail-manifest.js",
    "generate:exports": "node scripts/generate-exports.js",
    "prebuild": "npm run generate:thumbnail-manifest && npm run generate:exports",
    "build-storybook": "storybook build",
    "deploy-storybook": "storybook build && gh-pages -d storybook-static"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/web-components-vite": "10.5.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.8",
    "sharp": "^0.35.3",
    "storybook": "10.5.0",
    "storybook-addon-mermaid": "^0.2.7",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@storybook/icons": "^2.1.0",
    "lenis": "^1.3.25",
    "lit": "^3.3.3",
    "mermaid": "^11.16.0",
    "prismjs": "^1.30.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
